# Local runs need no credentials: DuckDB stands in for Snowflake.
# These are only read by your own tooling if you adapt the kit to a real
# Snowflake account. Never commit real values.
SNOWFLAKE_ACCOUNT=<account_locator>
SNOWFLAKE_USER=<user>
SNOWFLAKE_ROLE=MIGRATION_LOADER
SNOWFLAKE_WAREHOUSE=MIGRATION_WH
SNOWFLAKE_DATABASE=BAYOU_RETAIL
# Prefer key-pair auth; point at a key file outside the repo.
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake_rsa_key.p8
